# =====================================================================
# PanoWorld .gitignore
# Adapted from NVIDIA Cosmos-Predict2.5 with extra rules for secrets,
# checkpoints, training outputs, and OS clutter.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets — NEVER commit any of these
# ---------------------------------------------------------------------
*_token.txt
*_key.txt
*.key
*.pem
.env
.env.*
credentials*
secrets*
# Catch-all for API key files dropped at repo root
gemini_token*
openai_token*
hf_token*
anthropic_token*

# ---------------------------------------------------------------------
# Big data: checkpoints, outputs, eval results, training-set extracts
# ---------------------------------------------------------------------
/checkpoints/
/local_checkpoints/
/datasets/
/output/
/outputs/
/results/
/eval_results/
/eval_results_*/
/test_set_pkg/argus_videos/
/pano_anno_pkg/
/pano_anno_pkg.tar.gz
/test_set_pkg.tar.gz
/tmp/
/logs/
*.log
!docs/**/*.log

# Specific large media that should not land in git
DAP/weights/
DAP/third_party/
DAP/video_samples/

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.installed.cfg
.eggs/
build/
dist/
sdist/
wheels/
develop-eggs/
downloads/
.Python
.python-version-*

# Virtual envs
.venv/
venv/
ENV/
env/

# Test / coverage
.coverage
.coverage.*
.cache/
.pytest_cache/
.tox/
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Type checkers
.mypy_cache/
.pyre/
.pytype/
.pyrefly_cache/
.ruff_cache/

# ---------------------------------------------------------------------
# Jupyter / notebooks
# ---------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# Build artifacts in-tree
# ---------------------------------------------------------------------
*.lock
!uv.lock           # we DO want uv.lock committed
!package-lock.json # if any
node_modules/

# ---------------------------------------------------------------------
# Generated media you may produce locally
# ---------------------------------------------------------------------
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.wav
*.mp3
# But keep curated demo assets
!assets/**/*.mp4
!examples/**/*.mp4

# Generated thumbnails / overlays at repo root
*.png
*.jpg
*.jpeg
# Keep ones inside assets / docs / examples
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!examples/**/*.png
!examples/**/*.jpg
!DAP/**/*.png
!DAP/**/*.jpg
!DAP/**/*.jpeg
!.github/**/*.png

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
*.tar
*.tar.gz
*.zip
*.7z
*.rar
*.bak
*.tmp
